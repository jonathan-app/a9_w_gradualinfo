{
  "name": "gradualinfo-editorial",
  "version": "2.0.0",
  "private": true,
  "description": "GradualInfo Editorial — portal editorial sobre tecnologia e consumo digital",
  "homepage": "https://gradualinfo.com.br",
  "author": "Jonathan Simão",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.5.1"
  },
  "packageManager": "pnpm@12.5.1",
  "preinstall": "node scripts/enforce-pnpm.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "dev:spotlight": "concurrently \"pnpm dev\" \"spotlight\"",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --turbopack",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "deploy:full": "pnpm build && pnpm deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run",
    "gitattributes:sync": "node scripts/sync-gitattributes.mjs",
    "template:export": "node scripts/export-template.mjs",
    "check:quick": "pnpm build:next && pnpm lint",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commitlint:check": "commitlint --from HEAD~1 --to HEAD --verbose",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "bundle:analyze": "ANALYZE=true pnpm build:next",
    "pagespeed": "node scripts/pagespeed-monitor.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "supabase:start": "pnpm dlx supabase@2.119.0 start",
    "supabase:stop": "pnpm dlx supabase@2.119.0 stop",
    "supabase:reset": "pnpm dlx supabase@2.119.0 db reset",
    "supabase:test": "pnpm dlx supabase@2.119.0 test db",
    "security:audit": "pnpm audit",
    "security:sast": "node scripts/run-semgrep.mjs",
    "security:secrets": "node scripts/run-gitleaks.mjs"
  },
  "resolutions": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^11.0.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "hono": "^4.13.9",
    "hono-rate-limiter": "^0.4.2",
    "next": "^16.3.6",
    "next-themes": "^1.0.0-beta.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "9.39.5",
    "@next/bundle-analyzer": "^16.3.6",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@spotlightjs/spotlight": "^4.11.8",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-node": "^0.3.6",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "postcss": "8.5.28",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
