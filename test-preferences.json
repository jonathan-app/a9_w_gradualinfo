{
  "tool": "vitest",
  "framework": "vitest",
  "runner": "vitest",
  "testDir": "__tests__",
  "unitDirectory": "__tests__",
  "filePattern": "**/*.test.ts?(x)",
  "packageManager": "pnpm",
  "e2eTool": "playwright",
  "e2eFramework": "playwright",
  "e2eDirectory": "e2e",
  "componentTesting": "@testing-library/react",
  "a11y": true,
  "coverageThresholds": {
    "statements": 90,
    "branches": 90,
    "functions": 90,
    "lines": 90
  }
}
