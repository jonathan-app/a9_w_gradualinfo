#!/usr/bin/env sh
# ============================================================================
# .husky/pre-commit — o que roda antes de cada commit
# ============================================================================
# Apenas verificações baratas e locais:
#   1. Prettier (somente arquivos staged)
#   2. Typecheck (global, rápido)
#
# O /check, E2E, build e segurança rodam na CI/PR, não no pre-commit.
# Isso evita commits demorados e garante que o gate de aprovação fica
# centralizado na CI, ligado a uma decisão aprovada.
#
# Fluxo correto:
#   develop → test → check verify → check review → commit → CI → /check gate → PR → aprovação humana

set -e

# --- 1. Formatação dos arquivos staged ------------------------------------
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -n "$STAGED" ]; then
  # shellcheck disable=SC2086
  pnpm exec prettier --check --ignore-unknown $STAGED
else
  echo "pre-commit: nada staged para formatar"
fi

# --- 2. Tipos -------------------------------------------------------------
pnpm typecheck
