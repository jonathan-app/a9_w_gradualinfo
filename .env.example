# ============================================================================
# .env.example — TODAS as variáveis que o projeto reconhece
# ============================================================================
#
# Como usar:
#   cp .env.example .env.local   # e preencha os valores
#
# Regra dura: `.env*` está no .gitignore, exceto este arquivo. Se um segredo
# entrar no repositório, ele vaza no histórico mesmo que você apague o arquivo
# depois. O script `pnpm security:secrets` (gitleaks) procura exatamente isso.

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Copie a chave anon exibida por `pnpm supabase:start` para usar a stack local.
# Para o ambiente remoto, preencha a URL e a chave do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave `service_role` usada APENAS no servidor (nunca com prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Segredo aleatório de entrada, mínimo 32 bytes, diferente da senha.
SUPABASE_PREVIEW_TOKEN=
SUPABASE_PREVIEW_PASSWORD=
SUPABASE_PREVIEW_EMAIL=
SUPABASE_PREVIEW_USER_ID=

# ----------------------------------------------------------------------------
# Sentry
# ----------------------------------------------------------------------------
# Vazio desliga o Sentry no build (ver next.config.ts): sem DSN o plugin não
# inicializa nada, então o build local e o CI não dependem da rede do Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# ----------------------------------------------------------------------------
# Aplicação
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Ferramentas de qualidade (opcionais)
# ----------------------------------------------------------------------------
# Token para `pnpm pagespeed` (API do PageSpeed Insights).
PAGESPEED_API_KEY=
# Define a localidade usada na formatação: pt-BR | en-US.
NEXT_PUBLIC_LOCALE=pt-BR
