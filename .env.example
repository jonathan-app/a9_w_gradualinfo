# GradualInfo — modelo compartilhável. Preencha os valores somente em arquivos locais ignorados.
# Next.js carrega .env.local; Wrangler preview/dev carrega .dev.vars.
# NEXT_PUBLIC_* pode ser incluído no JavaScript do navegador.

# Site e Supabase (a aplicação usa ANON_KEY, não PUBLISHABLE_KEY)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sanity — entrega editorial
SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Opcional: padrão 2024-01-01
SANITY_API_VERSION=

# Administração — ADMIN_ACCESS_* são bindings do Worker
ADMIN_USER_ID=
ADMIN_EMAIL=
ADMIN_ACCESS_ISSUER=
ADMIN_ACCESS_AUD=
ADMIN_ACCESS_OWNER_EMAIL=
ADMIN_ACCESS_HOSTS=

# Preview — use valores distintos para o segredo de entrada e a assinatura
PREVIEW_SECRET=
PREVIEW_SIGNING_KEY=

# Recursos opcionais da aplicação
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_LOCALE=pt-BR
NEXT_PUBLIC_SANITY_STUDIO_URL=
SUPABASE_EDITORIAL_IMAGE_BUCKET=
SUPABASE_PREVIEW_TOKEN=
SUPABASE_PREVIEW_PASSWORD=
SUPABASE_PREVIEW_EMAIL=
SUPABASE_PREVIEW_USER_ID=
PAGESPEED_API_KEY=

# Somente para scripts de publicação editorial; não necessário para leitura do site.
SANITY_WRITE_TOKEN=

# Storage probatório WORM (Cloudflare R2 com Bucket Locks)
# Obrigatório para concessão do Selo de Preço Verificado em produção.
# Consulte: docs/specs/2026-10-16-2050-0021-pipeline-ofertas-worm-duravel.md
R2_EVIDENCE_BUCKET=gradualinfo-evidencias
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OFFERS_STORAGE_BACKEND=r2
OFFERS_STORAGE_WORM_VERIFIED=true

# Módulo de ofertas — segredos de autenticação de coletores e webhooks
# Nunca commitar valores reais; preencha somente em .env.local ou .dev.vars locais.
OFFERS_INGEST_SECRET=
OFFERS_WEBHOOK_SECRET=

# Administração — chave de serviço do Supabase (servidor somente)
# Obrigatória para RPCs privilegiadas e leitura comercial do dashboard.
# Nunca exponha no navegador; use wrangler secret put para produção.
SUPABASE_SERVICE_ROLE_KEY=
