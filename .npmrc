# ============================================================================
# .npmrc — comportamento do pnpm neste projeto
# ============================================================================

# node_modules "plano" em vez de symlinks. Motivo: o Storybook, o OpenNext
# (Cloudflare) e o Next resolvem módulos por caminho real; o layout com symlink
# do pnpm quebra a detecção de server/client boundary em alguns plugins.
node-linker=node-modules

# O projeto fixa peer deps com `pnpm.peerDependencyRules` e `pnpm.overrides`.
# Falhar aqui deixaria o install travado em conflito que o próprio projeto já
# resolveu por override.
strict-peer-dependencies=false
auto-install-peers=true

# Não baixar versões mais novas do que o lockfile, sem pedir.
resolution-mode=highest
update-notifier=false
