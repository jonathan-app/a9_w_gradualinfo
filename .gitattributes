# .gitattributes — gradualinfo
#
# Objetivo:
# - Normalizar finais de linha.
# - Excluir artefatos de desenvolvimento e arquivos sensíveis de `git archive`.
#
# IMPORTANTE:
# `export-ignore` afeta apenas exportações via `git archive` e ferramentas
# que respeitam esse atributo. NÃO impede `git add`, commits ou push.
# Use também `.gitignore`, secret scanning e regras de proteção no GitHub.

# Normalização de texto
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Artefatos de repositório, ferramentas e build
# ---------------------------------------------------------------------------
.git export-ignore
# .github preservado para manter workflows de CI e automacao de seguranca no template
.husky export-ignore
.kilo export-ignore
.agents export-ignore
.open-next export-ignore
.next export-ignore
dist export-ignore
build export-ignore
out export-ignore
node_modules export-ignore
coverage export-ignore
test-results export-ignore
playwright-report export-ignore
blob-report export-ignore
ci-results export-ignore
security-reports export-ignore
.lighthouseci export-ignore
.turbo export-ignore
.vercel export-ignore
.wrangler export-ignore
.terraform export-ignore
.serverless export-ignore
*.tsbuildinfo export-ignore
verify-result.json export-ignore

# ---------------------------------------------------------------------------
# Arquivos locais e credenciais que nunca devem entrar em um template exportado
# Não use padrões amplos que excluam `.env.example` ou exemplos documentados.
# ---------------------------------------------------------------------------
.env export-ignore
.env.local export-ignore
.env.development.local export-ignore
.env.test.local export-ignore
.env.production.local export-ignore
.env.development export-ignore
.env.production export-ignore
.dev.vars export-ignore
.dev.vars.* export-ignore
# .npmrc contem configuracao essencial de linker plano do pnpm para o projeto, sem credenciais
.netrc export-ignore
.pypirc export-ignore
*.pem export-ignore
*.key export-ignore
*.p12 export-ignore
*.pfx export-ignore
*.keystore export-ignore
id_rsa export-ignore
id_dsa export-ignore
id_ecdsa export-ignore
id_ed25519 export-ignore
credentials.json export-ignore
service-account*.json export-ignore
secrets/ export-ignore
private/ export-ignore
.local/ export-ignore
localhost-cert.pem export-ignore
localhost-key.pem export-ignore

# Arquivos locais que podem conter sessões, cookies ou dados privados
*storage-state*.json export-ignore
*playwright-auth*.json export-ignore
*.har export-ignore
*.log export-ignore
*.sqlite export-ignore
*.sqlite3 export-ignore
*.db export-ignore
*.dump export-ignore
*.sql.gz export-ignore
*.bak export-ignore
*.backup export-ignore
*.orig export-ignore
*.rej export-ignore
*~ export-ignore
.DS_Store export-ignore
Thumbs.db export-ignore

