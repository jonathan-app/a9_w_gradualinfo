{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "prettier.requireConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "files.associations": {
    "app/globals.css": "tailwindcss"
  },
  "tailwindCSS.experimental.configFile": "app/globals.css",
  "tailwindCSS.classFunctions": ["cn", "clsx", "cva", "twMerge"],
  "[tailwindcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "cSpell.language": "en,pt_BR",
  "cSpell.words": [
    "GradualInfo",
    "Supabase",
    "Turbopack",
    "Vitest",
    "Wrangler",
    "pnpm",
    "OpenNext",
    "pgTAP"
  ],
  "cSpell.ignorePaths": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/.wrangler/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    ".agents/**",
    "referencias/**",
    "scratch/**",
    "pnpm-lock.yaml",
    "skills-lock.json"
  ],
  "markdownlint.config": {
    "MD013": false
  },
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "eslint.format.enable": false,
  "git.enableSmartCommit": false,
  "git.confirmSync": true,
  "emmet.includeLanguages": {
    "typescriptreact": "html"
  },
  "testing.automaticallyOpenPeekView": "never",
  "files.exclude": {
    "**/.next": true,
    "**/.open-next": true,
    "**/.wrangler": true,
    "**/coverage": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/storybook-static": true
  },
  "search.exclude": {
    "**/.next/**": true,
    "**/.open-next/**": true,
    "**/.wrangler/**": true,
    "**/coverage/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/storybook-static/**": true,
    "**/node_modules/**": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/.open-next/**": true,
    "**/.wrangler/**": true,
    "**/coverage/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/storybook-static/**": true,
    "**/node_modules/**": true
  }
}
