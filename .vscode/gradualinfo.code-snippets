    "prefix": "rsc",
    "scope": "typescriptreact",
    "description": "Componente de servidor com classes combinadas por cn",
    "body": [
      "import { cn } from '@/lib/utils/cn';",
      "",
      "interface ${1:Component}Props {",
      "  className?: string;",
      "}",
      "",
      "export function ${1:Component}({ className }: ${1:Component}Props) {",
