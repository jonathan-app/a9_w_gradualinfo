  },
  "Client Component": {
    "prefix": "rcc",
    "scope": "typescriptreact",
    "description": "Folha interativa com estado usado e botão acessível",
    "body": [
      "'use client';",
      "",
      "import { useState } from 'react';",
      "",
      "export function ${1:Toggle}() {",
      "  const [active, setActive] = useState(false);",
