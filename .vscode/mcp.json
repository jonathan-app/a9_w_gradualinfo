{
  "servers": {
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@0.4.0"],
      "cwd": "${workspaceFolder}"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--isolated"],
      "cwd": "${workspaceFolder}"
    }
  }
}
