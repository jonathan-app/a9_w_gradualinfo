{
  // ==========================================================================
  // wrangler.jsonc — configuração do runtime Cloudflare Workers
  // ==========================================================================
  //
  // Este arquivo NÃO é lido pelo Next. Ele é lido pelo OpenNext (que gera o
  // bundle em .open-next/) e pelo Wrangler (que publica).
  //
  // O JSON tem comentários (é JSONC); não renomeie para .json.
  //
  // Referência: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gradualinfo",
  "main": "scripts/cloudflare-worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    // Logs já estavam ativos; traces precisam de habilitação independente.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    // O Wrangler chama a detecção de problemas de `issues`.
    "issues": {
      "enabled": true,
    },
  },
  // Evita apagar variáveis configuradas no painel ao publicar uma nova versão.
  "keep_vars": true,
  // `pnpm deploy` sobrescreve este worker; `pnpm build` gera a pasta .open-next.
  "assets": {
    // A plataforma não pode servir caminhos administrativos antes da admissão.
    "run_worker_first": true,
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  // `vars` (não secrets): variáveis lidas pelo Worker em produção.
  // O Next.js em dev lê `.env.*`, mas o Worker publicado só lê este arquivo
  // mais os secrets. Uma variável que só existe em `.env.production.local`
  // é invisível no runtime deployado — e `env.ts:39` cai no placeholder
  // inválido, derrubando `createPublicClient()` e gerando HTTP 500 em `/`.
  // Configure NEXT_PUBLIC_SUPABASE_ANON_KEY diretamente no Worker antes do
  // deploy; o valor não é versionado neste arquivo.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://sjngngsjvotagwctzpde.supabase.co",
    "NEXT_PUBLIC_SITE_URL": "https://gradualinfo.com.br",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "4iipvaar",
    "SANITY_PROJECT_ID": "4iipvaar",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PREVIEW_SESSION_DO",
        "class_name": "PreviewSessionDO",
      },
      {
        "name": "ADMIN_RATE_LIMIT_DO",
        "class_name": "AdminRateLimitDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PreviewSessionDO"],
    },
    {
      "tag": "v2-admin-rate-limit",
      "new_sqlite_classes": ["AdminRateLimitDO"],
    },
  ],
  "routes": [
    { "pattern": "gradualinfo.com.br/*", "zone_name": "gradualinfo.com.br" },
    {
      "pattern": "www.gradualinfo.com.br/*",
      "zone_name": "gradualinfo.com.br",
    },
  ],
}
